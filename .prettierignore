# Dependencies
node_modules/
pnpm-lock.yaml

# Prettier's own config. Extensionless, so prettier parses it as JSON5 and
# "formats" it into single quotes plus a trailing comma — which is no longer
# valid strict JSON, and anything doing JSON.parse on it then fails.
.prettierrc

# Runtime state — never in the repo, but a stray local copy must not be rewritten.
data/
secrets/

# Hand-authored SVG: prettier reflows the path data into something unreadable.
public/*.svg

# Test fixtures are DATA, not source. test/page.test.js and test/feed.test.js
# readFileSync these verbatim and assert on what the parser makes of them, so
# reformatting one silently changes the thing under test.
test/fixtures/

# Published blog posts (bind-mounted read-only at /app/content). Authored prose;
# formatting it is churn with no engineering value.
content/

# Generated by release-please; reformatting it fights the tool.
CHANGELOG.md

# Local scratch, already gitignored.
*.local.md

# Logs
*.log
