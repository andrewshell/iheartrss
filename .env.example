# iheartrss.com — environment.
#
# Copy to `.env`. Everything here is validated at boot and the process exits on a
# bad value (plan §9) — a misconfigured deploy should fail loudly at startup, not
# quietly serve wrong absolute URLs for a week.
#
# Only the variables the app currently reads are set below. The rest of §9's
# table (ADMIN_TOKEN, IP_HMAC_KEY_FILE, the revalidation knobs, …) arrives with
# the phase that first uses it.

# Port the server listens on.
PORT=3000

# Public origin. Every absolute URL the app emits (feed links, badge snippets)
# is built from this, so it must match how the site is actually reached.
SITE_URL=https://iheartrss.com

# Hosts that count as "a link back to us" when verifying a submission.
# Point this at your dev origin's host to test the badge check locally.
LINKBACK_HOSTS=iheartrss.com,www.iheartrss.com

# Where the SQLite database lives. Must name a file, not a directory. The parent
# directory is created at boot and write-probed, so a root-owned bind mount fails
# immediately with an actionable message instead of at the first query.
# In the container this is /data/iheartrss.db, backed by the ./data bind mount.
DATABASE_PATH=./data/iheartrss.db


# --- Behind a reverse proxy -------------------------------------------------
# Not read yet — client-IP derivation lands with the submit flow. Documented here
# because getting the second one wrong is a security bug, not a typo.

# Trust X-Forwarded-For. Only ever true when the app is genuinely unreachable
# except through the proxy — which is what the 127.0.0.1 port binding in
# docker-compose.yml buys you.
# TRUST_PROXY=false

# The number of proxies to skip PAST the rightmost X-Forwarded-For entry.
#
# A single nginx in front means 0, NOT 1. nginx's $proxy_add_x_forwarded_for
# (and the Caddy/Traefik equivalents) *appends* the immediate peer, so the app
# sees `<client-supplied garbage>, <real peer>` and the real client is the LAST
# entry. Worked example: with `X-Forwarded-For: 1.2.3.4, 9.9.9.9` and hops=0 the
# client IP is 9.9.9.9. Peeling one more would return 1.2.3.4 — a value the
# client chose — which is a one-header bypass of every rate limit and lets
# anyone poison the stored IP hashes to frame someone else.
# TRUSTED_PROXY_HOPS=0

# --- Outbound fetching (plan §5) --------------------------------------------

# Total budget across every fetch in one submission. Up to 6 requests (plus
# scheme-fallback retries and 5 redirect hops each) share this one clock, so a
# slow site can't hold a synchronous POST past the reverse proxy's own timeout.
SUBMIT_BUDGET_MS=30000

# Per-request sanity cap. The effective timeout is min(this, budget remaining).
FETCH_TIMEOUT_MS=8000

# 5 MB. Exceeding it is an error, never a truncation: a truncated page parses
# fine and merely lacks the link-back, which revalidation would read as a
# deliberate opt-out and delist a member whose homepage just got big.
MAX_RESPONSE_BYTES=5242880
